# 식품안전나라(foodsafetykorea.go.kr) 오픈API 인증키
FOODSAFETY_API_KEY=

# 카카오 REST API 키 (내 주변 업소 기능의 주소 → 좌표 변환용)
KAKAO_REST_API_KEY=

# 선택 항목 (비워두면 기본값 사용)
# 지오코딩 초당 최대 호출 수 (기본 8), 동시 작업 수 (기본 4)
GEOCODE_RPS=
GEOCODE_WORKERS=
# 서버 시작 시 전체 동기화 여부 (기본 true)
STARTUP_SYNC=
# 값을 넣으면 POST /api/sync 에 X-Sync-Token 헤더가 필요 (배포 시 권장)
SYNC_TOKEN=
# SQLite 파일 경로 (기본 backend/hygiene.db)
DB_PATH=
# 허용할 프론트 출처, 쉼표 구분 (기본 http://localhost:5173,http://127.0.0.1:5173)
CORS_ORIGINS=
